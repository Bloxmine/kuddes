# /opt/kuddes/.env on the server. Readable only by the kuddes user (chmod 600).
NODE_ENV=production

# Make up a long random password: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://kuddes:CHANGE_ME@127.0.0.1:5433/kuddes

# The app listens only on this machine; Caddy passes requests on
HOST=127.0.0.1
PORT=8787
# Caddy is the reverse proxy: trust its X-Forwarded-For for visitors' IP addresses
TRUST_PROXY=1
PUBLIC_URL=https://kuddes.nl

UPLOAD_DIR=/opt/kuddes/uploads
BUDDYPOKE_DIR=/opt/kuddes/web
BEJEWELED_DIR=/opt/kuddes/games/bejeweled/web

# Optional: Cloudflare's captcha on the sign-up form, against spam accounts (DEPLOY.md, step 12.5)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Mail from noreply@kuddes.nl through Brevo: confirming new members, wachtwoord vergeten,
# new addresses, "you're approved" (DEPLOY.md, step 12). How new members get in (a confirmation
# mail, or your approval) is switched in Beheer → Aanmeldingen; without SMTP_HOST it starts on approval.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Kuddes <noreply@kuddes.nl>"

# Optional: your own TURN server for games between players behind strict NAT (DEPLOY.md, step 10)
# TURN_URLS=turn:kuddes.nl:3478
# TURN_SECRET=
